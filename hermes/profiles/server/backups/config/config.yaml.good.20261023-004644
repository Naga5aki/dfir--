model:
  default: qwen3.8-27b-forensics
  provider: custom
  base_url: http://127.0.0.1:8095/v1
  api_key: ${LLAMA_API_KEY}
  context_length: 65536
  api_mode: chat_completions

terminal:
  backend: docker
  cwd: "D:/forensics/cases/CASE-2026-001/work"
  timeout: 180
  docker_image: forensics-toolbox:1.0
  docker_network: false
  docker_mount_cwd_to_workspace: true
  docker_volumes:
    - "D:/forensics/cases/CASE-2026-001/evidence:/cases/current/evidence:ro"
    - "D:/forensics/cases/CASE-2026-001/out:/cases/current/out"
    - "D:/forensics/cases/CASE-2026-001/logs:/cases/current/logs"
    - "D:/forensics/tools:/tools:ro"
  container_cpu: 4
  container_memory: 4096
  container_disk: 51200
  container_persistent: true

agent:
  max_turns: 20
  run_budget_seconds: 900
  save_trajectories: true

memory:
  memory_enabled: false
  user_profile_enabled: false
  nudge_interval: 0

tool_loop_guardrails:
  hard_stop_enabled: true

mcp_servers: {}
_config_version: 51
